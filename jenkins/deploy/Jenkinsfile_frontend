pipeline {
    agent { label "wsl" }
    
    parameters {
        string(name: 'version', defaultValue: 'latest', description: 'Docker Image Tag to deploy')
    }

    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                script {
                    withCredentials([usernamePassword(credentialsId: 'github-creds', passwordVariable: 'GIT_PASS', usernameVariable: 'GIT_USER')]) {
                        sh """
                            ENCODED_PASSWORD=\$(echo "\$GIT_PASS" | sed 's/@/%40/g')
                            git clone https://\$GIT_USER:\$ENCODED_PASSWORD@github.com/\$GIT_USER/project-server-less.git .
                        """
                    }
                }
            }
        }

        stage('Deploy Frontend to K8s') {
            steps {
                script {
                    echo "Starting Ansible Deployment for Frontend..."
                    withCredentials([
                        usernamePassword(credentialsId: 'docker-hub-creds', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')
                    ]) {
                        sh """
                            cd ansible
                            ansible-playbook -i inventory/hosts.ini k8s-manifests/deploy_frontend.yml \
                            --extra-vars "version=${params.version} docker_user=${DOCKER_USERNAME}"
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}