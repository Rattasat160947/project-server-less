pipeline {
    agent { label "wsl" }
    
    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                script {
                    sh """
                        set -a
                        . /home/rattasat/Desktop/serverless/project-server-less/.env
                        set +a
                        ENCODED_PASSWORD=\$(echo "\${PASSWORD}" | sed 's/@/%40/g')
                        git clone https://\${USERNAME}:\${ENCODED_PASSWORD}@github.com/\${USERNAME}/project-server-less.git .
                    """
                }
            }
        }

        stage('Deploy to Kubernetes Cluster') {
            steps {
                script {
                    echo "Deploy Frontend to Kubernetes Cluster..."
                    sh """
                        set -a
                        . /home/rattasat/Desktop/serverless/project-server-less/.env
                        set +a
                        cd ansible/frontend && ansible-playbook -i hosts.ini deploy_frontend.yml --extra-vars "version=${version}"
                    """
                }
            }
        }

        stage('Cleanup') {
            steps {
                cleanWs()
            }
        }
    }
}
