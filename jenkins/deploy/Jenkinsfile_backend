pipeline {
    agent { label "wsl" }
    
    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                script {
                    withCredentials([usernamePassword(credentialsId: 'github-creds', passwordVariable: 'GIT_PASS', usernameVariable: 'GIT_USER')]) {
                        sh """
                            ENCODED_PASSWORD=\$(echo "\$GIT_PASS" | sed 's/@/%40/g')
                            git clone https://\$GIT_USER:\$ENCODED_PASSWORD@github.com/\$GIT_USER/project-server-less.git .
                        """
                    }
                }
            }
        }

        stage('Deploy to Kubernetes Cluster') {
            steps {
                script {
                    echo "Deploy Backend to Kubernetes Cluster..."
                    withCredentials([
                        usernamePassword(credentialsId: 'github-creds', passwordVariable: 'PASSWORD', usernameVariable: 'USERNAME'),
                        usernamePassword(credentialsId: 'docker-hub-creds', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')
                    ]) {
                        sh """
                            export USERNAME=\$USERNAME
                            export PASSWORD=\$PASSWORD
                            export DOCKER_USERNAME=\$DOCKER_USERNAME
                            
                            cd ansible/backend && ansible-playbook -i hosts.ini deploy_backend.yml --extra-vars "version=${version}"
                        """
                    }
                }
            }
        }

        stage('Cleanup') {
            steps {
                cleanWs()
            }
        }
    }
}
