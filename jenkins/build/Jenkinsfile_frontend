pipeline {
    agent { label "wsl" }
    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                script {
                    sh """
                        set -a
                        . /home/rattasat/Desktop/serverless/project-server-less/.env
                        set +a
                        ENCODED_PASSWORD=\$(echo "\${PASSWORD}" | sed 's/@/%40/g')
                        git clone https://\${USERNAME}:\${ENCODED_PASSWORD}@github.com/\${USERNAME}/project-server-less.git .
                    """
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    sh """
                        set -a
                        . /home/rattasat/Desktop/serverless/project-server-less/.env
                        set +a
                        echo "Building frontend Image..."
                        cd frontend && docker build . -t \${DOCKER_USERNAME}/server-frontend:${version}
                    """
                }
            }
        }
        
        stage('Test Docker Images') {
            steps {
                script {
                    sh """
                        set -a
                        . /home/rattasat/Desktop/serverless/project-server-less/.env
                        set +a
                        echo "Testing frontend Image ${params.version}..."
                        docker run --rm \${DOCKER_USERNAME}/server-frontend:${params.version} echo 'frontend Test Passed!'
                    """
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    sh """
                        set -a
                        . /home/rattasat/Desktop/serverless/project-server-less/.env
                        set +a
                        echo "Logging in to Docker Hub..."
                        echo \${PASSWORD} | docker login -u \${USERNAME} --password-stdin
                        echo "Pushing frontend Image to Docker Hub..."
                        docker push \${DOCKER_USERNAME}/server-frontend:${version}
                    """
                }
            }
        }

        stage('Cleanup') {
            steps {
                script {
                    sh """
                        set -a
                        . /home/rattasat/Desktop/serverless/project-server-less/.env
                        set +a
                        echo 'Cleaning up local Docker images...'
                        docker rmi \${DOCKER_USERNAME}/server-frontend:${version}
                        docker logout
                    """
                }
            }
        }
    }
}
