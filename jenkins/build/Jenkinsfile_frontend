pipeline {
    agent { label "wsl" }
    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                script {
                    withCredentials([usernamePassword(credentialsId: 'github-creds', passwordVariable: 'GIT_PASS', usernameVariable: 'GIT_USER')]) {
                        sh """
                            ENCODED_PASSWORD=\$(echo "\$GIT_PASS" | sed 's/@/%40/g')
                            git clone https://\$GIT_USER:\$ENCODED_PASSWORD@github.com/\$GIT_USER/project-server-less.git .
                        """
                    }
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-creds', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                        sh """
                            echo "Building frontend Image ${params.version} ..."
                            cd frontend && docker build . -t \$DOCKER_USER/server-frontend:${params.version}
                        """
                    }
                }
            }
        }
        
        stage('Test Docker Images') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-creds', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                        sh """
                            echo "Testing frontend Image..."
                            docker run --rm \$DOCKER_USER/server-frontend:${params.version} echo 'frontend Test Passed!'
                        """
                    }
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-creds', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                        sh """
                            docker logout
                            echo "Logging in to Docker Hub..."
                            echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin
                            echo "Pushing frontend Image version: ${params.version} ..."
                            docker push \$DOCKER_USER/server-frontend:${params.version}
                        """
                    }
                }
            }
        }

        stage('Cleanup') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-creds', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                        sh """
                            export DOCKER_CONFIG="\$PWD/.docker"
                            echo 'Cleaning up local Docker images...'
                            docker rmi -f \$DOCKER_USER/server-frontend:${params.version} || true
                            docker logout
                        """
                    }
                }
            }
        }
    }
}
